# Almo server settings. Copy to .env (same folder as app.py), fill in, restart Almo.
# .env is in .gitignore - never commit it. Locally on a Mac you don't need this file.

# Required on a server: never open without Google sign-in
ALMO_SERVER=1

# Google sign-in (Google Cloud -> Credentials -> OAuth client ID, type "Web application",
# redirect URI https://outreach.uprankd.com/auth/callback)
ALMO_GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
ALMO_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
ALMO_ALLOWED_DOMAIN=uprankd.com
# Optional: only these people (comma separated). Empty = everyone @uprankd.com
ALMO_ALLOWED_EMAILS=

# Shared PostgreSQL database. Empty = SQLite file in ALMO_DATA_DIR
DATABASE_URL=postgresql://almo:PASSWORD@127.0.0.1:5432/almo

# Where Almo keeps its files (session key, SQLite if used, exports)
ALMO_DATA_DIR=/home/runcloud/almo-data
# Address people open in the browser (used for Google's return address)
ALMO_PUBLIC_URL=https://outreach.uprankd.com
# Local port NGINX forwards to
ALMO_PORT=8765
ALMO_NO_BROWSER=1
